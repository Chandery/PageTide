{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperDigHelper",
  "version": "0.1.0",
  "identifier": "com.paperdighelper.desktop",
  "build": {
    "frontendDist": "../app/static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "resources/paperdighelper-server/": "backend/"
    },
    "category": "Productivity",
    "shortDescription": "Local-first paper discovery and reading companion",
    "longDescription": "PaperDigHelper keeps recommendations, feedback, and reading data on your Mac."
  }
}
