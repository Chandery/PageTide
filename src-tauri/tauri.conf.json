{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperDigHelper",
  "version": "0.1.0",
  "identifier": "com.paperdighelper.desktop",
  "build": {
    "frontendDist": "../app/static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/paperdighelper-server/": "backend/"
    },
    "category": "Productivity",
    "shortDescription": "Local-first paper discovery and reading companion",
    "longDescription": "PaperDigHelper keeps recommendations, feedback, and reading data on your computer.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
